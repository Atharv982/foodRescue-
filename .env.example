# Supabase (Optional for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail Email Delivery for OTP Verification
# 1. Enable 2-Step Verification in your Google Account (myaccount.google.com/security)
# 2. Generate an App Password (myaccount.google.com/apppasswords)
# 3. Add credentials below:
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
